# Prime Ges — modelo de variáveis para o servidor novo (SEM valores).
# Preencha os valores só no cofre/na Vercel. NUNCA cole valores no chat nem no repositório.

# ---- 3 que MUDAM na virada (apontam para o Supabase self-hosted) ------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://api.primeges.com.br
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- NÃO mudam, mas têm de ser os MESMOS de hoje ----------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
TWO_FACTOR_ENCRYPTION_KEY=
ANTIFRAUD_HASH_SECRET=
EVOPAY_API_KEY=
EVOPAY_API_BASE_URL=
RESEND_API_KEY=
EMAIL_FROM=

# ---- Gerais ------------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://primeges.com.br
NEXT_PUBLIC_APP_ENV=production

# ---- Chat AI -----------------------------------------------------------------------------------
CHAT_AI_ENABLED=true
CHAT_AI_CONFIRM_ENABLED=true
CHAT_DAILY_LIMIT=200

# ---- Só no .env do Supabase self-hosted (na máquina, NÃO na Vercel) ----------------------------
