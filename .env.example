# =============================================================================
# ENVIRONMENT VARIABLES — EXEMPLO
# Copie este arquivo para ".env.local" e preencha com os valores reais.
# NUNCA cometa o arquivo ".env.local" (ou qualquer .env com valores reais) no Git.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# URL e chave pública (anon) do projeto Supabase.
# Estas duas são expostas ao navegador (prefixo NEXT_PUBLIC_) — por isso
# dependem inteiramente do Row Level Security (RLS) para proteger os dados.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (service_role). NUNCA deve ter o prefixo NEXT_PUBLIC_.
# Usada apenas em código server-side (Route Handlers, Server Actions,
# Edge Functions). Ignora RLS — nunca deve chegar ao frontend.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
# URL pública onde a aplicação está rodando (usada em redirects de auth, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ambiente atual: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# EvoPay (assinatura do Prime Ges via Pix — docs.evopay.cash)
# -----------------------------------------------------------------------------
# Server-only. NUNCA usar o prefixo NEXT_PUBLIC_ nestas duas — a EvoPay não
# tem ambiente de sandbox/teste, só um token de produção por conta.
EVOPAY_API_KEY=
EVOPAY_API_BASE_URL=https://pix.evopay.cash/v1
